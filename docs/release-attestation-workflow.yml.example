# TEMPLATE ONLY — do not place this file under .github/workflows/ until the
# repository owner confirms GitHub artifact-attestation eligibility for this
# private repository. See docs/RELEASE_WORKFLOW_RESEARCH_NOTES.md.
name: Build and attest release evidence

on:
  push:
    tags: ["v*"]

permissions:
  contents: read
  id-token: write
  attestations: write

jobs:
  release-evidence:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - name: Check out immutable tag source
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          fetch-depth: 0
      - name: Set up Python
        uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: "3.11"
      - name: Set up uv
        uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
        with:
          version: "0.12.1"
          enable-cache: true
      - name: Synchronize locked environment
        run: uv sync --frozen --all-extras
      - name: Prepare deterministic artifact and CycloneDX SBOM
        run: |
          set -euo pipefail
          source_date_epoch="$(git log -1 --format=%ct)"
          uv run python scripts/prepare_release_evidence.py \
            --repository . \
            --output-dir dist \
            --source-date-epoch "$source_date_epoch"
      - name: Generate build provenance attestation
        id: provenance
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        with:
          subject-path: dist/before-deploy-0.1.0.tar.gz
      - name: Generate SBOM attestation
        id: sbom
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        with:
          subject-path: dist/before-deploy-0.1.0.tar.gz
          sbom-path: dist/before-deploy-0.1.0.cdx.json
      - name: Retain artifact, SBOM, checksums, and local bundles
        uses: actions/upload-artifact@65c4c4a1ddee5b72f698fdd19549f0f0fb45cf08 # v4.6.0
        with:
          name: before-deploy-release-evidence
          path: |
            dist/
            ${{ steps.provenance.outputs.bundle-path }}
            ${{ steps.sbom.outputs.bundle-path }}
          if-no-files-found: error
          retention-days: 30
